CAREOPS_ENVIRONMENT=development
CAREOPS_CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_PASSWORD=replace-with-a-unique-local-password
# Assistant: "deterministic" (default, no key needed) answers from saved
# results. "openai" or "ollama" only rephrase those answers; if the provider
# is unavailable the deterministic answer is returned with a fallback reason.
CAREOPS_LLM_PROVIDER=deterministic
CAREOPS_LLM_MODEL=gpt-4o-mini
# Used only when CAREOPS_LLM_PROVIDER=ollama (must be a loopback URL)
CAREOPS_LLM_BASE_URL=http://127.0.0.1:11434
# Used only when CAREOPS_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Required outside development for POST /optimization/run, /alerts and
# /recommendations/generate (sent as the X-API-Key header).
CAREOPS_API_KEY=
CAREOPS_INTERACTIVE_RATE_LIMIT_PER_MINUTE=20
